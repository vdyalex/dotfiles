[user]
	name = {{ onepasswordRead "op://Personal/Identity/Internet Details/username" }}
	email = {{ onepasswordRead "op://Personal/Identity/Internet Details/email" }}
[core]
	pager = delta
	ignorecase = false
	editor = vim
	excludesfile = /Users/vdyalex/.gitignore_global
[delta]
	features = catppuccin-latte
	navigate = true
	side-by-side = true
	line-numbers = true
[gpg]
	format = ssh
	program = /opt/homebrew/bin/gpg
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	defaultKeyCommand = op read op://Personal/SSH/public_key
[commit]
	gpgsign = true
	template = /Users/vdyalex/.stCommitMsg
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[pull]
	rebase = false
	ff = only
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	default = upstream
[advice]
	addEmptyPathspec = false
